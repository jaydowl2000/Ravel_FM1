+    {{RGB(178, 140, 255), RGB(52, 36, 84), RGB(232, 140, 214), RGB(66, 36, 60), RGB(200, 170, 255)},
+     {RGB(110, 56, 200), RGB(226, 214, 248), RGB(176, 40, 140), RGB(246, 214, 236), RGB(120, 70, 210)}},
