+static const uint16_t th_dark[TC_N] = {
+    RGB(3, 3, 3), /* BG */
+    RGB(17, 17, 17), /* PANEL */
+    RGB(36, 36, 36), /* LINE */
+    RGB(92, 92, 92), /* DIM */
+    RGB(152, 152, 152), /* MID */
+    RGB(232, 232, 230), /* INK */
+    RGB(255, 255, 255), /* WHITE */
+    RGB(10, 10, 10), /* KPANEL the knob strip: a shade off black, with grain */
