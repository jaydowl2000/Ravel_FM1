-# KIND asks first only when the track's sound was changed by hand (v1.23.1): a fresh or loaded sound switches at
-# once; after a knob edit the first turn of KIND asks (TURN AGAIN: NEW SOUND) and a second turn switches
-wait 300
-tap EDIT
-wait 100
-expect page SOUND
-expect tp 1 KIND 0
-# a fresh sound: at once, and back
-turn K1 1
-wait 400
-expect tp 1 KIND 1
-turn K1 -1
-wait 400
-expect tp 1 KIND 0
-# changed by hand (VELO): the first turn only asks
-turn K4 5
-wait 100
-turn K1 1
-wait 100
-expect tp 1 KIND 0
-shot kind_guard.png
-wait 400
-turn K1 1
-wait 400
-expect tp 1 KIND 1
-# the new sound is fresh again: at once
-turn K1 -1
-wait 400
-expect tp 1 KIND 0
-# a preset loaded: nothing of yours to lose, at once
-turn K4 5
-wait 100
-turn PRESET 1
-wait 300
-turn K1 1
-wait 400
-expect tp 1 KIND 1
-turn K1 -1
-wait 3000
