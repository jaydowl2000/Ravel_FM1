         ui.wf_name[t][0] = 0;
         ui.wf_pre[t] = -1;
@@ -3333,6 +3450,14 @@ static void buttons(uint32_t now_btn)
             ui.layer_used[b] = 0;
         }
     }
+    undo_watch();
+    if ((down & ((1u << B_OCTDN) | (1u << B_OCTUP))) && (now_btn & (1u << B_EDIT)) && !(now_btn & (1u << B_SEQ)) &&
+        cur_page()->pic != PIC_WEFT) {                  /* EDIT + OCT-: undo the last change to the steps, EDIT + OCT+: redo it */
+        int redo = (down & (1u << B_OCTUP)) != 0;
+        msg(undo_step(redo ? 1 : -1) ? (redo ? "REDO" : "UNDO") : (redo ? "NOTHING TO REDO" : "NOTHING TO UNDO"));
+        down &= ~((1u << B_OCTDN) | (1u << B_OCTUP));
+        ui.layer_used[B_EDIT] = 1;
+    }
     if (ui.wf_list && ((up & (1u << B_EDIT)) || !(now_btn & (1u << B_EDIT)))) {   /* the list of blocks: EDIT let go */
         kb_t kt = {K_WF, 1};
         ui.wf_list = 0;
diff --git a/tests/scenarios/undo.rvl b/tests/scenarios/undo.rvl
new file mode 100644
index 0000000..47d0e7d
--- /dev/null
+++ b/tests/scenarios/undo.rvl
@@ -0,0 +1,98 @@
+# UNDO / REDO: EDIT + OCT- undoes the last change to the steps on screen, EDIT + OCT+ redoes it.
+# One gesture (changes less than 0.7 s apart) is one undo.
+wait 300
+clear 1
+wait 300
+expect steps 1 0
+# nothing to undo yet
+press EDIT
+tap OCT-
+release EDIT
+wait 50
+expect msg NOTHING TO UNDO
+wait 1500
+# two separate edits
+press SEQ
+tapkey 0
+release SEQ
+wait 900
+expect steps 1 1
+press SEQ
+tapkey 2
+release SEQ
+wait 900
+expect steps 1 2
+# undo the second, then the first
+press EDIT
+tap OCT-
+release EDIT
+wait 50
+expect steps 1 1
+expect msg UNDO
+wait 200
+press EDIT
+tap OCT-
+release EDIT
+wait 50
+expect steps 1 0
+wait 200
+press EDIT
+tap OCT-
+release EDIT
+wait 50
+expect steps 1 0
+expect msg NOTHING TO UNDO
+wait 1500
+# redo both, then nothing more to redo
+press EDIT
+tap OCT+
+release EDIT
+wait 50
+expect steps 1 1
+expect msg REDO
+wait 200
+press EDIT
+tap OCT+
+release EDIT
+wait 50
+expect steps 1 2
+wait 200
+press EDIT
+tap OCT+
+release EDIT
+wait 50
+expect steps 1 2
+expect msg NOTHING TO REDO
+wait 1500
+# a new edit after an undo drops what could be redone
+press EDIT
+tap OCT-
+release EDIT
+wait 900
+expect steps 1 1
+press SEQ
+tapkey 4
+release SEQ
+wait 900
+expect steps 1 2
+press EDIT
+tap OCT+
+release EDIT
+wait 50
+expect steps 1 2
+expect msg NOTHING TO REDO
+wait 1500
+# two steps within one gesture are one undo
+press SEQ
+tapkey 6
+tapkey 7
+release SEQ
+wait 900
+expect steps 1 4
+press EDIT
+tap OCT-
+release EDIT
+wait 50
+expect steps 1 2
+# a step's own settings come back too (velocity)
+expect stepvel 1 1 100
